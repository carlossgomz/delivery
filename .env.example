# Base de datos (Prisma + Supabase). DATABASE_URL es la conexión pooled
# (pgbouncer, para la app en runtime); DIRECT_URL es la conexión directa
# que Prisma necesita para migraciones (prisma migrate / db push).
DATABASE_URL="postgresql://usuario:password@aws-x-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@aws-x-region.pooler.supabase.com:5432/postgres"

# Clave de acceso de los DUEÑOS (configuración: tasa, teléfono, productos,
# y ahora también cancelar/eliminar pedidos en cualquier momento)
ADMIN_PASSWORD="tu_clave_de_dueño_aqui"

# Clave de acceso del EMPLEADO autorizado de delivery
# (pedidos, mensajes, clientes y llamadas — sin acceso a configuración/productos)
DELIVERY_PASSWORD="tu_clave_de_delivery_aqui"

# Token compartido con el POS de la tienda (Rust) para los endpoints
# server-a-server bajo /api/pos/* — sincronización de catálogo y de
# pedidos. Generar uno largo y aleatorio; debe coincidir con el que se
# configura en el POS (tabla config.delivery_sync_token).
POS_SYNC_TOKEN="un_token_largo_y_aleatorio_compartido_con_el_pos"

# Cloudflare R2 (almacenamiento de fotos: productos, categorías y
# comprobantes de pago). Reemplazó a Vercel Blob — estas son las variables
# que usa /api/upload hoy en día.
R2_ACCOUNT_ID="tu_account_id_de_cloudflare"
R2_ACCESS_KEY_ID="tu_access_key_id"
R2_SECRET_ACCESS_KEY="tu_secret_access_key"
R2_BUCKET_NAME="nombre-del-bucket"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

# Upstash Redis (tier gratis) — usado para las alertas en "tiempo real"
# (pedido nuevo, mensajes de chat, pedido eliminado). Si conectás la
# integración de Upstash desde el Marketplace de Vercel, puede crear las
# variables con el naming legado de "Vercel KV" (KV_REST_API_URL /
# KV_REST_API_TOKEN) en vez de estas — el proyecto soporta ambos naming,
# así que basta con completar UNO de los dos pares.
UPSTASH_REDIS_REST_URL="https://tu-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="tu_token_aqui"
# KV_REST_API_URL="https://tu-db.upstash.io"
# KV_REST_API_TOKEN="tu_token_aqui"

# Vercel Blob (LEGACY — ya no se usa para subir imágenes, todo pasó a R2
# arriba). Solo hace falta si vas a correr "npm run db:reset-produccion",
# que todavía usa esto para borrar comprobantes viejos que hayan quedado
# en Blob de antes de la migración. Si no vas a correr ese script, podés
# omitir esta variable.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_TU_TOKEN_AQUI"
