# Base de datos (Prisma)
DATABASE_URL="postgresql://usuario:password@localhost:5432/tu_base_datos"

# Vercel Blob Storage Token (Requerido para subir comprobantes)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_TU_TOKEN_AQUI"

# Clave secreta para sesión Admin (si la usas)
ADMIN_SECRET="tu_clave_secreta_aqui"

# Upstash Redis (tier gratis) — usado para las alertas en "tiempo real"
# (pedido nuevo, mensajes de chat). Ver pasos de configuración en Vercel.
UPSTASH_REDIS_REST_URL="https://tu-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="tu_token_aqui"