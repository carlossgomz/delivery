      "memory": 1536,
      "maxDuration": 15
    },
    "app/api/orders/\\[id\\]/route.ts": {
      "memory": 1536,
      "maxDuration": 15
    },
    "app/api/orders/stream/route.ts": {
      "memory": 512,
