    },
    "app/api/chat/mensajes/route.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "app/api/config/route.ts": {
      "memory": 1024,
      "maxDuration": 10
    },
    "app/api/products/route.ts": {
      "memory": 1024,
      "maxDuration": 10
