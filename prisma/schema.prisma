generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Las categorías siguen siendo texto libre en cada Product (no se migró a
// una relación) para no romper nada existente. Esta tabla es un
// complemento aparte, solo para guardarle una imagen representativa a
// cada nombre de categoría (los círculos del catálogo del cliente). Si una
// categoría no tiene fila acá, simplemente no tiene imagen propia todavía.
model Categoria {
  id        String   @id @default(cuid())
  nombre    String   @unique
  imagenUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String      @id @default(cuid())
  codigo           String      @unique
  nombre           String
  // costoUsd y margenPorcentaje quedaron sin uso: el admin ahora carga
  // precioUsd directamente como precio final. Se dejan en el schema
  // para no perder datos históricos, pero ningún endpoint los lee ni escribe.
  costoUsd         Float?
  margenPorcentaje Float?      @default(30)
  precioUsd        Float       @default(0)
  categoria        String
  imagenUrl        String?
  activo           Boolean     @default(true)
  // Si es true, el producto se vende por peso (ej. carnes, quesos,
  // vegetales "X KILO"): precioUsd es el precio por KILOGRAMO y el
  // cliente elige cuántos kg quiere en vez de un número de unidades.
  // Si es false (default), se vende por unidad como siempre.
  porPeso          Boolean     @default(false)
  // Solo tiene sentido si porPeso = true: permite que ADEMÁS del modo por
  // peso (kg), el cliente pueda pedirlo por unidades sueltas (ej. "3
  // tomates", "2 cebollas"). precioUnidadUsd es el precio fijo por unidad
  // en ese modo — independiente de precioUsd (que sigue siendo el precio
  // por kilo). No reemplaza el modo por peso, coexisten los dos.
  permiteUnidad    Boolean     @default(false)
  precioUnidadUsd  Float?
  // Orden manual del producto dentro de su categoría (menor = aparece
  // primero). Todos los productos existentes arrancan en 0 y se
  // desempatan por fecha de creación, así que no cambia nada hasta que el
  // admin reordene explícitamente desde el panel.
  orden            Int         @default(0)
  createdAt        DateTime    @default(now())
  OrderItem        OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  // Estos tres campos se guardan siempre como "foto" del pedido (nombre,
  // teléfono, dirección en ese momento), tenga o no cuenta el cliente.
  // Así el historial no cambia si luego el cliente edita su perfil.
  clienteNombre   String
  clienteTelefono String
  direccion       String
  estado          String      @default("PENDIENTE_VERIFICACION")
  tasaCambio      Float
  totalUsd        Float?
  totalBs         Float?
  comprobanteUrl  String?
  notas           String?
  notaPago        String?
  // "WEB" (por defecto, el cliente hizo el pedido desde el catálogo) o
  // "LLAMADA" (el personal de tienda lo creó a mano porque el cliente
  // llamó por teléfono). Sirve para no perder el registro de esas ventas
  // y para distinguirlas de un vistazo en /admin/pedidos.
  origen          String      @default("WEB")
  // Sistema de crédito autorizado por la tienda: si es true, este pedido
  // se entregó/confirmó sin exigir comprobante de pago inmediato porque el
  // cliente tiene crédito habilitado (Cliente.creditoAutorizado). Queda
  // como deuda hasta que la tienda marca creditoPagado = true a mano
  // cuando cobra. No afecta el flujo de preparación/entrega del pedido.
  esCredito       Boolean     @default(false)
  creditoPagado   Boolean     @default(false)
  createdAt       DateTime    @default(now())
  // Se llena automáticamente la primera vez que el pedido llega a
  // "ENTREGADO" (ver /api/orders/[id]). Junto con createdAt permite
  // calcular y mostrar cuánto tardó realmente la entrega en /admin/pedidos.
  entregadoAt     DateTime?
  items           OrderItem[]

  // Opcional: si el pedido lo hizo un cliente con cuenta registrada, queda
  // enlazado aquí para poder mostrarle su historial de pedidos.
  clienteId       String?
  cliente         Cliente?    @relation(fields: [clienteId], references: [id])
}

// Cuenta simple de cliente: se registra con cédula + contraseña para no
// tener que volver a escribir nombre/teléfono/dirección en cada pedido y
// para poder ver el historial de pedidos ya hechos. La cédula es el
// identificador con el que el cliente inicia sesión; el teléfono queda
// solo como dato de contacto.
model Cliente {
  id           String   @id @default(cuid())
  nombre       String
  cedula       String   @unique
  telefono     String
  direccion    String
  passwordHash String
  // Interruptor que solo la tienda puede activar (desde /admin/clientes):
  // permite que este cliente reciba pedidos "a crédito" (pagar después) en
  // el checkout, en vez de tener que subir comprobante de pago de una vez.
  creditoAutorizado Boolean @default(false)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String
  // Para productos por unidad es un número entero de unidades (1, 2, 3...).
  // Para productos por peso (Product.porPeso = true) son los kilogramos
  // pedidos y puede traer decimales (0.5, 1.25, etc.), por eso es Float.
  cantidad   Float
  // true si ESTA línea se pidió "por unidad" (ej. 3 tomates) en vez de
  // por peso, para un producto híbrido (Product.permiteUnidad = true).
  // En ese caso "cantidad" es la cantidad de unidades (entero), no
  // kilogramos, y "precioUsd" es el precio POR UNIDAD (no por kilo).
  vendidoPorUnidad Boolean @default(false)
  // Si la tienda ajusta la cantidad/peso real disponible (ej. pidieron 3
  // mayonesas y solo hay 1, o pidieron 200g de queso y al pesar salieron
  // 220g), aquí queda la cantidad que el cliente pidió ORIGINALMENTE antes
  // del ajuste. "cantidad" pasa a ser la cantidad real/confirmada (así el
  // resto de la app -que ya lee "cantidad" para totales y listados- no
  // necesita cambiar). Queda en null mientras no se haya ajustado nada.
  cantidadOriginal Float?
  // Solo para líneas vendidoPorUnidad = true: el peso real (en gramos) que
  // la tienda pesó al armar el pedido (ej. cliente pidió "3 tomates", la
  // tienda pesa y anota 340). Es un dato interno/de inventario — no
  // cambia lo que paga el cliente, que sigue siendo por unidad.
  pesoConfirmadoGramos Int?
  precioUsd  Float
  disponible Boolean?
  product    Product  @relation(fields: [productId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Config {
  id             Int      @id @default(autoincrement())
  tasaCambio     Float    @default(1)
  // Número que usa el botón "Llamar a la tienda" y el que se muestra en el
  // chat. Se edita desde el mismo panel donde se edita la tasa.
  telefonoTienda String?  @default("04266215863")
  // Interruptor desde el admin para cerrar la tienda temporalmente: al
  // ponerlo en false se sigue mostrando el catálogo y se puede registrar
  // un cliente nuevo, pero no se pueden crear pedidos (ni desde el
  // catálogo ni por la API) hasta que se vuelva a activar.
  pedidosHabilitados Boolean @default(true)
  // Ganancia en dólares que se le suma a CADA producto antes de convertir a
  // bolívares: (precioUsd + ganancia) x tasaCambio = total que ve el
  // cliente. Solo lo edita el dueño (rol "admin"), desde /admin junto a la
  // tasa y el teléfono.
  ganancia       Float    @default(0.10)
  updatedAt      DateTime @updatedAt
}

// Una conversación por cliente. El cliente no tiene cuenta ni login: se
// identifica con un id aleatorio que el navegador genera una sola vez y
// guarda en localStorage (igual que ya se hace con el carrito).
model Conversacion {
  id              String    @id @default(cuid())
  clienteId       String    @unique
  clienteNombre   String?
  clienteTelefono String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  mensajes        Mensaje[]
}

model Mensaje {
  id             String       @id @default(cuid())
  conversacionId String
  // "CLIENTE" o "TIENDA"
  remitente      String
  texto          String
  leido          Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversacion   Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
}
